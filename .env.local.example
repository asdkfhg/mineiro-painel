# Copie este arquivo para .env.local e preencha os valores.
# Nunca commite o .env.local de verdade (ele já está no .gitignore).

# Painel > Project Settings > Data API, no seu projeto Supabase
SUPABASE_URL=
# Painel > Project Settings > API Keys > service_role (secreta, não é a "anon")
SUPABASE_SERVICE_ROLE_KEY=

# Senha única que o Douglas usa para entrar no painel
PAINEL_SENHA=

# Qualquer string aleatória longa (ex: gere com `openssl rand -hex 32`)
SESSION_SECRET=
